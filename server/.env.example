# Copy this file to .env for local development.
# On Render, add each of these under Environment instead (see docs/DEPLOY.md).

# MongoDB connection string. Locally this can be a local MongoDB or Atlas.
# In production use your Atlas string, ideally with its own database name, e.g. .../myseat-prod?...
MONGO_URI=mongodb://localhost:27017/ticketing

# Secret used to sign login tokens. Use a long random value in production, never this one.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# How long a login lasts, e.g. 1h, 1d, 7d
JWT_EXPIRES_IN=1d

# Port to listen on. Render sets this automatically, so don't add it there.
PORT=5000

# development | production | test
# "production" hides error details and stack traces; "test" turns off rate limiting.
NODE_ENV=development

# How long a seat hold lasts before the seats are released (seconds)
HOLD_DURATION_SECONDS=300

# Frontend address(es) allowed to call the API from a browser (CORS).
# Several are allowed, separated by commas, with no trailing slash, e.g.
# CLIENT_URL=https://myseat.vercel.app,https://myseat-git-main-yourname.vercel.app
CLIENT_URL=http://localhost:5173
